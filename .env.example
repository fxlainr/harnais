# Copier ce fichier en .env (jamais versionné) puis remplir.

# Emplacement du coffre. Hors de ~/Documents : iCloud corrompt les dépôts Git.
HARNAIS_VAULT=~/harnais-coffre

# Fournisseur par agent : lmstudio | anthropic | ollama | auto (Anthropic si une clé est configurée, sinon local)
HARNAIS_TAGUEUR=lmstudio
HARNAIS_GARDIEN=auto
HARNAIS_AUDITEUR=auto

# LM Studio (serveur local compatible OpenAI)
LMSTUDIO_URL=http://localhost:1234/v1
# google/gemma-4-e4b : 8/8 JSON valides, 12 s par session, aucun montant recopié (essai du 2026-10-17).
# qwen/qwen3.5-9b : plus précis, 17 s, a recopié un montant client. Voir scripts/comparer_modeles.py.
LMSTUDIO_MODEL=google/gemma-4-e4b

# Anthropic (jamais versionné : ce fichier .env est ignoré par Git)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Ollama (alternative locale)
OLLAMA_MODEL=llama3.1
